#!/usr/bin/env bash
# Conecta pgAdmin y Postman en la Mac con la base y la API del EC2.
# Uso: deploy/aws/bin/db-tunnel [puerto_db_local] [puerto_api_local]
# Mantener esta terminal abierta mientras se usan; Ctrl+C cierra el túnel.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$BIN_DIR/_state.sh"

LOCAL_PORT="${1:-15432}"
API_PORT="${2:-18000}"
if ! [[ "$LOCAL_PORT" =~ ^[0-9]+$ && "$API_PORT" =~ ^[0-9]+$ ]] ||
   (( LOCAL_PORT < 1024 || LOCAL_PORT > 65535 ||
      API_PORT < 1024 || API_PORT > 65535 || LOCAL_PORT == API_PORT )); then
  echo "Los puertos locales deben ser distintos y estar entre 1024 y 65535." >&2
  exit 2
fi

if ! nc -G 5 -z "$EIP" 22 >/dev/null 2>&1; then
  "$BIN_DIR/allow-my-ip"
fi

DB_IP=$("$BIN_DIR/ec2-ssh" \
  'cd ~/semanticClassification && db_id=$(docker compose -f docker-compose.prod.yml --profile local-db ps -q db) && test -n "$db_id" && docker inspect --format "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}" "$db_id"')
if ! [[ "$DB_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "No se pudo obtener la IP del contenedor PostgreSQL en EC2." >&2
  exit 1
fi

echo "Túnel listo para pgAdmin: host 127.0.0.1, puerto $LOCAL_PORT."
echo "API lista para Postman: http://127.0.0.1:$API_PORT."
echo "Mantén esta terminal abierta; Ctrl+C cierra la conexión."
exec ssh -i "$SSH_KEY" -o BatchMode=yes -o ConnectTimeout=10 \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
  -N -L "127.0.0.1:$LOCAL_PORT:$DB_IP:5432" \
  -L "127.0.0.1:$API_PORT:127.0.0.1:8000" "ubuntu@$EIP"
